{
	"name": "phpbbmodders/newspage",
	"type": "phpbb-extension",
	"description": "A news page that shows the latest topics from chosen forums, shortened to a set length, with monthly archives and categories.",
	"homepage": "https://www.phpbbmodders.com/",
	"version": "1.4.0-dev",
	"keywords": [
		"phpbb",
		"extension",
		"news",
		"newspage"
	],
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "phpBB Modders",
			"email": "board@phpbbmodders.com",
			"homepage": "https://www.phpbbmodders.com/",
			"role": "Extension Developer"
		},
		{
			"name": "Joas Schilling",
			"email": "nickvergessen@gmx.de",
			"homepage": "https://github.com/nickvergessen",
			"role": "Past Developer"
		}
	],
	"require": {
		"php": ">=7.4",
		"ext-dom": "*",
		"composer/installers": "^1.0 || ^2.0"
	},
	"extra": {
		"display-name": "NV Newspage",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.19,<4.1.0@dev"
		}
	}
}
